{
  "name": "ribbon-passport-universal",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:web": "playwright test",
    "export:web": "expo export --platform web && node scripts/offline-web.mjs",
    "serve": "node scripts/serve.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@types/node": "^26.6.5",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-sharing": "~58.0.19",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "lossless-json": "^4.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "~19.3.0",
    "fake-indexeddb": "^6.2.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
