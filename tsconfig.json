{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "types": ["react", "node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "playwright.config.ts", "expo-env.d.ts"]
}
