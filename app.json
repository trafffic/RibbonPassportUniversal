{
  "expo": {
    "name": "Ribbon Passport",
    "slug": "ribbon-passport-universal",
    "version": "0.1.0",
    "scheme": "ribbonpassport",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ie.ribbonpassport.universal"
    },
    "android": {
      "package": "ie.ribbonpassport.universal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#270641"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "Ribbon Passport",
      "shortName": "Ribbons",
      "themeColor": "#1E2C1F",
      "backgroundColor": "#1E2C1F"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-sharing"
    ]
  }
}
